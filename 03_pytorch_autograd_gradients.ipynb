      "source": [
        "# autgrad and gradient\n",
        "import torch\n",
        "x=torch.tensor(3.0,requires_grad=True)\n",
        "y=x**2\n",
        "y.backward()\n",
        "print(\"Value of x:\", x.item())\n",
        "print(\"Value of y:\", y.item())\n",
        "print(\"Gradient of x:\", x.grad.item())\n"
      ]
    }
  ]
}